# Optional settings. Copy to .env in the repository root and run commands there.
# All values below match src/dogma/core/config.py defaults.

# Data/content root; omit to use this checkout. Use an absolute path if overriding.
# DOGMA_REPO_ROOT=/absolute/path/to/dogma

# OpenAI-compatible local model server. The gateway requires a loopback URL.
DOGMA_LLM_BASE_URL=http://127.0.0.1:8080/v1
DOGMA_LLM_MODEL=qwen3.8-27b-q6

# Reserved for future external providers; true does not enable a remote provider.
DOGMA_ALLOW_EXTERNAL=false

# Harness limits. A problem's meta.yaml timeout_s takes precedence over this timeout.
DOGMA_RUN_TIMEOUT_S=30
DOGMA_RUN_MEMORY_MB=2048
# Multiplies every run's time limit. Raise it on a machine much slower than a recent Mac;
# values below 1 are rejected.
DOGMA_RUN_TIMEOUT_SCALE=1.0

# Set false for scratch grading. This disables attempt recording, not session/card writes.
DOGMA_RECORD_ATTEMPTS=true
